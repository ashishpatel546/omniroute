# OmniRoute gateway — copy to .env (git-ignored) and adjust.
#
# Only server-side settings belong here. Upstream provider credentials
# (OpenAI, Gemini, Anthropic, …) are NOT env vars: they live encrypted in the
# gateway's SQLite store on the omniroute-data volume. Add them with
#   docker compose exec -T omniroute omniroute keys add openai --stdin
# or in the dashboard at http://localhost:20128.

# Host port the gateway is published on (loopback only — see docker-compose.yml).
# 20128 is OmniRoute's own default and what clients expect.
OMNIROUTE_PUBLISH_PORT=20128

# Require an API key on the inference plane (/v1/*).
#
# false — anything that can reach the published port can spend your upstream
#         credits. Tolerable only because the port is bound to 127.0.0.1.
# true  — clients must send `Authorization: Bearer <gateway key>`. Mint the key
#         in the dashboard (Endpoints), then put it in each client's config.
#
# Note: /v1/models always requires a valid key regardless of this setting, so a
# client whose health check probes /v1/models needs a minted key either way.
REQUIRE_API_KEY=false

# Let the dashboard reveal a minted key's full value after creation. Off by
# default; turn on only if you lost a key and cannot rotate the client.
ALLOW_API_KEY_REVEAL=false

# Encrypts provider credentials at rest in the SQLite store (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Keep it safe: without this exact value the existing store cannot be decrypted.
STORAGE_ENCRYPTION_KEY=
